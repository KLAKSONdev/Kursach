<Window x:Class="Kursach.ADialogs.EventEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мероприятие" 
        Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,10,5,0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText" 
                   Text="Добавление мероприятия" 
                   FontSize="18" 
                   FontWeight="Normal" 
                   Foreground="#333333"
                   Margin="0,0,0,15"/>

        <!-- Поля ввода -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Название -->
                <TextBlock Text="Название мероприятия *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EventNameTextBox" Style="{StaticResource TextBoxStyle}"/>

                <!-- Тип мероприятия -->
                <TextBlock Text="Тип мероприятия *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="EventTypeComboBox" 
                          Style="{StaticResource ComboBoxStyle}"
                          DisplayMemberPath="EventTypeName" 
                          SelectedValuePath="EventTypeID"/>

                <!-- Дата и время -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="EventDatePicker" Style="{StaticResource DatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Время" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EventTimeTextBox" Text="00:00" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Место проведения -->
                <TextBlock Text="Место проведения" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LocationTextBox" Style="{StaticResource TextBoxStyle}"/>

                <!-- Организатор -->
                <TextBlock Text="Организатор" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OrganizerTextBox" Style="{StaticResource TextBoxStyle}"/>

                <!-- Обязательное -->
                <CheckBox x:Name="IsRequiredCheckBox" Content="Обязательное мероприятие" Margin="5,10,5,5"/>

                <!-- Описание -->
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionTextBox" 
                         Style="{StaticResource TextBoxStyle}" 
                         Height="80" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/>

                <TextBlock Text="* - обязательные поля" FontSize="10" Foreground="#999999" Margin="5,10,5,5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" 
                    Content="Сохранить" 
                    Width="100" Height="35" 
                    Margin="5"
                    Background="#27AE60" 
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Width="100" Height="35" 
                    Margin="5"
                    BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>