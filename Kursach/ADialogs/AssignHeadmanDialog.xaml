<Window x:Class="Kursach.ADialogs.AssignHeadmanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение старосты группы" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText" 
                   Text="Назначение старосты группы" 
                   FontSize="18" 
                   FontWeight="Normal" 
                   Foreground="#333333"
                   Margin="0,0,0,15"/>

        <!-- Информация о группе -->
        <Border Grid.Row="1" 
                Background="#F5F5F5" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Группа:" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" x:Name="GroupNameText" Text=""/>
            </Grid>
        </Border>

        <!-- Список студентов группы -->
        <TextBlock Grid.Row="2" Text="Студенты группы:" Margin="0,0,0,5"/>
        <ListBox Grid.Row="2" 
                 x:Name="StudentsListBox"
                 Margin="0,20,0,10"
                 DisplayMemberPath="DisplayName"
                 SelectionMode="Single"
                 BorderBrush="#CCCCCC"
                 Background="White">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Информация о текущем старосте -->
        <Border Grid.Row="2" 
                Background="#FFF9E6" 
                BorderBrush="#F1C40F" 
                BorderThickness="1"
                Padding="8"
                VerticalAlignment="Bottom"
                Margin="0,0,0,50">
            <TextBlock x:Name="CurrentHeadmanText" 
                       Text="Текущий староста: не назначен"
                       Foreground="#333333"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AssignButton" 
                    Content="Назначить старостой" 
                    Style="{StaticResource ToolbarButton}"
                    Background="#27AE60" 
                    Foreground="White"
                    BorderThickness="0"
                    Click="AssignButton_Click"/>
            <Button x:Name="ClearButton" 
                    Content="Снять старосту" 
                    Style="{StaticResource ToolbarButton}"
                    Background="#E67E22" 
                    Foreground="White"
                    BorderThickness="0"
                    Click="ClearButton_Click"/>
            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Style="{StaticResource ToolbarButton}"
                    Background="#E1E1E1" 
                    Foreground="#333333"
                    BorderBrush="#ADADAD"
                    BorderThickness="1"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>