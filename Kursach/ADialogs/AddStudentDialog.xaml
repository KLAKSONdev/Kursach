<Window x:Class="Kursach.ADialogs.AddStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление студента" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Добавление нового студента" 
                   FontSize="18" Foreground="#333333" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Обязательные поля -->
                <GroupBox Header="Обязательные поля" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <TextBlock Text="Фамилия *" Margin="5"/>
                        <TextBox x:Name="LastNameTextBox" Height="28" Margin="5"/>

                        <TextBlock Text="Имя *" Margin="5"/>
                        <TextBox x:Name="FirstNameTextBox" Height="28" Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Основная информация -->
                <GroupBox Header="Основная информация" Margin="0,0,0,10" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Отчество" Margin="5"/>
                            <TextBox x:Name="MiddleNameTextBox" Height="28" Margin="5"/>

                            <TextBlock Text="Группа" Margin="5"/>
                            <ComboBox x:Name="GroupComboBox" Height="28" Margin="5"
                                      DisplayMemberPath="GroupName" SelectedValuePath="GroupID"/>

                            <TextBlock Text="Телефон" Margin="5"/>
                            <TextBox x:Name="PhoneTextBox" Height="28" Margin="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Пол" Margin="5"/>
                            <ComboBox x:Name="GenderComboBox" Height="28" Margin="5">
                                <ComboBoxItem Content="М"/>
                                <ComboBoxItem Content="Ж"/>
                            </ComboBox>

                            <TextBlock Text="Дата рождения" Margin="5"/>
                            <DatePicker x:Name="BirthDatePicker" Height="28" Margin="5"/>

                            <TextBlock Text="Email" Margin="5"/>
                            <TextBox x:Name="EmailTextBox" Height="28" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Социальный статус -->
                <GroupBox Header="Социальный статус" Margin="0,0,0,10" Padding="5">
                    <WrapPanel>
                        <CheckBox x:Name="IsOrphanCheckBox" Content="Сирота" Margin="5"/>
                        <CheckBox x:Name="IsDisabledCheckBox" Content="Инвалид" Margin="5"/>
                        <CheckBox x:Name="IsFromLargeFamilyCheckBox" Content="Многодетная семья" Margin="5"/>
                        <CheckBox x:Name="IsLowIncomeCheckBox" Content="Малообеспеченный" Margin="5"/>
                        <CheckBox x:Name="IsEmployedCheckBox" Content="Работает" Margin="5"/>
                    </WrapPanel>
                </GroupBox>

                <TextBlock Text="* - обязательные поля" FontSize="10" Foreground="#999999" Margin="5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Height="32" Margin="5"
                    Background="#27AE60" Foreground="White" BorderThickness="0"
                    Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Height="32" Margin="5"
                    Background="#E1E1E1" Foreground="#333333" BorderBrush="#ADADAD"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>