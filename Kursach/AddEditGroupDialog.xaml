<Window x:Class="Kursach.AddEditGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление группы" 
        Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,10,5,0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText" 
                   Text="Добавление группы" 
                   FontSize="18" 
                   FontWeight="Normal" 
                   Foreground="#333333"
                   Margin="0,0,0,15"/>

        <!-- Поля ввода -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Название группы (обязательное поле) -->
                <TextBlock Text="Название группы *" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="GroupNameTextBox" Style="{StaticResource TextBoxStyle}"/>

                <!-- Курс -->
                <TextBlock Text="Курс" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="CourseComboBox" Style="{StaticResource ComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="1 курс"/>
                    <ComboBoxItem Content="2 курс"/>
                    <ComboBoxItem Content="3 курс"/>
                    <ComboBoxItem Content="4 курс"/>
                </ComboBox>

                <!-- Специальность -->
                <TextBlock Text="Специальность" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="SpecialtyComboBox" 
                          Style="{StaticResource ComboBoxStyle}"
                          DisplayMemberPath="DisplayName" 
                          SelectedValuePath="SpecialtyID"/>

                <!-- Форма обучения -->
                <TextBlock Text="Форма обучения" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="FormComboBox" Style="{StaticResource ComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Очная"/>
                    <ComboBoxItem Content="Заочная"/>
                    <ComboBoxItem Content="Очно-заочная"/>
                </ComboBox>

                <!-- Учебный год -->
                <TextBlock Text="Учебный год" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="YearComboBox" Style="{StaticResource ComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="2023-2024"/>
                    <ComboBoxItem Content="2024-2025"/>
                    <ComboBoxItem Content="2025-2026"/>
                    <ComboBoxItem Content="2026-2027"/>
                </ComboBox>

                <!-- Язык обучения -->
                <TextBlock Text="Язык обучения" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource ComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Русский"/>
                    <ComboBoxItem Content="Белорусский"/>
                    <ComboBoxItem Content="Английский"/>
                </ComboBox>

                <TextBlock Text="* - обязательные поля" FontSize="10" Foreground="#999999" Margin="5,15,5,5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" 
                    Content="Сохранить" 
                    Style="{StaticResource DialogButtonStyle}"
                    Background="#27AE60" 
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Style="{StaticResource DialogButtonStyle}"
                    Background="#E1E1E1" 
                    Foreground="#333333"
                    BorderBrush="#ADADAD"
                    BorderThickness="1"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>