<Window x:Class="Kursach.ParticipationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Участники мероприятия" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        WindowState="Normal">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <TextBlock x:Name="EventTitleText" 
                       Text="Мероприятие" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Информация о мероприятии -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Дата:" FontWeight="Bold" Margin="5,0"/>
                <TextBlock Grid.Column="1" x:Name="EventDateText" Text="-" Margin="5,0,20,0"/>

                <TextBlock Grid.Column="2" Text="Место:" FontWeight="Bold" Margin="5,0"/>
                <TextBlock Grid.Column="3" x:Name="EventLocationText" Text="-" Margin="5,0"/>
            </Grid>
        </Border>

        <!-- Таблица студентов -->
        <DataGrid Grid.Row="2" 
                  x:Name="StudentsGrid" 
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="100"/>
                <DataGridCheckBoxColumn Header="Участвует" Binding="{Binding IsParticipating}" Width="80"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Style="{StaticResource ToolbarButton}"
                    Background="#27AE60" 
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
            <Button Content="Отмена" 
                    Style="{StaticResource ToolbarButton}"

                    BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>