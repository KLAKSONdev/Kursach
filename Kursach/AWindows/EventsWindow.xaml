<Window x:Class="Kursach.AWindows.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мероприятия" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        WindowState="Normal">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#ADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Кнопки только для админа -->
            <Button x:Name="AddEventBtn" Content="Добавить" Style="{StaticResource ToolbarButton}" Width="80" Click="AddEvent_Click"/>
            <Button x:Name="EditEventBtn" Content="Редактировать" Style="{StaticResource ToolbarButton}" Width="100" Click="EditEvent_Click"/>
            <Button x:Name="DeleteEventBtn" Content="Удалить" Style="{StaticResource ToolbarButton}" Width="80" Click="DeleteEvent_Click"/>

            <Separator Width="20" Background="Transparent"/>

            <!-- Кнопка для записи (видна всем) -->
            <Button x:Name="ParticipateBtn" Content="Отметить участие" Style="{StaticResource ToolbarButton}" Width="120" Click="Participate_Click"/>

            <Separator Width="20" Background="Transparent"/>

            <!-- Фильтры -->
            <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="TypeFilter" Width="120" Height="28" Margin="5,0" SelectionChanged="Filter_Changed"/>

            <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="5,0"/>
            <DatePicker x:Name="DateFilter" Width="120" Height="28" Margin="5,0" SelectedDateChanged="Filter_Changed"/>
        </StackPanel>

        <!-- Таблица мероприятий -->
        <DataGrid x:Name="EventsGrid" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="EventsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EventID}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding EventName}" Width="200"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding EventType}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Время" Binding="{Binding EventTime}" Width="80"/>
                <DataGridTextColumn Header="Место" Binding="{Binding Location}" Width="150"/>
                <DataGridTextColumn Header="Организатор" Binding="{Binding Organizer}" Width="150"/>
                <DataGridTextColumn Header="Участников" Binding="{Binding ParticipantsCount}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>